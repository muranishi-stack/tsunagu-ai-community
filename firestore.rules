rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // ヘルパー関数: 管理者判定
    // admins/{uid} に自分の UID のドキュメントがあれば admin
    // ============================================================
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ============================================================
    // users/{userId}: プロフィール
    // ============================================================
    match /users/{userId} {
      // 認証済ユーザーは全員のプロフィールを閲覧可（マッチ・スワイプ用）
      allow read: if request.auth != null;
      // 自分自身のドキュメントのみ作成・更新可
      allow create, update: if request.auth != null && request.auth.uid == userId;
      // 削除は admin のみ
      allow delete: if isAdmin();
    }

    // ============================================================
    // users/{uid}/likes_received/{likerId}: あなたへのいいね
    // 受信者本人のみ閲覧可。いいねした本人が作成/取消できる。
    // ============================================================
    match /users/{userId}/likes_received/{likerId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == likerId;
      allow delete: if request.auth != null && request.auth.uid == likerId;
    }

    // ============================================================
    // superlike_notifications/{id}: つなぐ 通知
    // ============================================================
    match /superlike_notifications/{notifId} {
      allow read: if request.auth != null
                  && resource.data.to_uid == request.auth.uid;
      allow create: if request.auth != null
                  && request.resource.data.from_uid == request.auth.uid;
      // 受信者が既読化 / 送信者が取消
      allow update: if request.auth != null
                  && resource.data.to_uid == request.auth.uid;
      allow delete: if request.auth != null
                  && resource.data.from_uid == request.auth.uid;
    }

    // ============================================================
    // swipes/{swipeId}: スワイプ記録
    // ============================================================
    match /swipes/{swipeId} {
      allow read: if request.auth != null
                  && (resource.data.from_uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null
                  && request.resource.data.from_uid == request.auth.uid;
      // 自分のスワイプは更新（再スワイプ）/削除（もどす）可能
      allow update, delete: if request.auth != null
                  && resource.data.from_uid == request.auth.uid;
    }

    // ============================================================
    // matches/{matchId}: マッチ
    // ============================================================
    match /matches/{matchId} {
      allow read: if request.auth != null
                  && (request.auth.uid in resource.data.uids || isAdmin());
      allow create: if request.auth != null
                  && request.auth.uid in request.resource.data.uids;
      allow update: if request.auth != null
                  && request.auth.uid in resource.data.uids;
      allow delete: if isAdmin();
    }

    // ============================================================
    // chats/{matchId}/messages/{messageId}: チャットメッセージ
    // ============================================================
    match /chats/{matchId}/messages/{messageId} {
      allow read: if request.auth != null
                  && (
                    (
                      exists(/databases/$(database)/documents/matches/$(matchId))
                      && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.uids
                    )
                    || isAdmin()
                  );
      allow create: if request.auth != null
                  && request.resource.data.sender_uid == request.auth.uid
                  && exists(/databases/$(database)/documents/matches/$(matchId))
                  && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.uids;
      allow update, delete: if false;
    }

    // ============================================================
    // reports/{reportId}: 通報
    // ============================================================
    match /reports/{reportId} {
      allow read: if request.auth != null
                  && (resource.data.reporter_id == request.auth.uid || isAdmin());
      allow create: if request.auth != null
                  && request.resource.data.reporter_id == request.auth.uid;
      // ステータス更新・削除は admin のみ
      allow update, delete: if isAdmin();
    }

    // ============================================================
    // ai_flags/{flagId}: AI フラグ (admin のみ閲覧可・書き込みは Admin SDK)
    // ============================================================
    match /ai_flags/{flagId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ============================================================
    // transactions/{txId}: 取引履歴
    // ============================================================
    match /transactions/{txId} {
      allow read: if request.auth != null
                  && (resource.data.user_id == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ============================================================
    // announcements/{announceId}: お知らせ
    // ============================================================
    match /announcements/{announceId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ============================================================
    // admins/{adminId}: 管理者ドキュメント
    // 自分自身の管理者ドキュメントのみ読み取り可
    // ============================================================
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false;
    }

    // ============================================================
    // _health_check: 接続テスト用
    // ============================================================
    match /_health_check/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
